{
  "type_id": "legacy_dimension",
  "label": "旧库方法学维度",
  "description": "从 kind=methodology-dimension 迁移；check/family 在 raw_json 中原样保留。",
  "spec": {
    "tier": "entry",
    "fields": {
      "statement": {
        "kind": "text",
        "required": true,
        "max_len": 2000
      },
      "family": {
        "kind": "text",
        "max_len": 200
      },
      "severity": {
        "kind": "enum",
        "values": [
          "hard",
          "soft",
          "info"
        ]
      },
      "rationale": {
        "kind": "text",
        "max_len": 4000
      },
      "raw_json": {
        "kind": "text",
        "required": true,
        "max_len": 20000
      }
    },
    "render": [
      "statement",
      "family",
      "severity",
      "rationale",
      "raw_json"
    ],
    "required_facets": [
      "topic"
    ],
    "review_checklist": [
      "原始记录完整保存在 raw_json",
      "legacy_id 与旧库一致",
      "状态映射正确"
    ],
    "require_sources": false
  }
}