{
  "type_id": "legacy_methodology",
  "label": "旧库方法学约束",
  "description": "从 kind=methodology 条目迁移；constraints 在 raw_json 中原样保留，供 E4 使用。",
  "spec": {
    "tier": "entry",
    "fields": {
      "statement": {
        "kind": "text",
        "required": true,
        "max_len": 2000
      },
      "severity": {
        "kind": "enum",
        "values": [
          "hard",
          "soft",
          "info"
        ]
      },
      "rationale": {
        "kind": "text",
        "max_len": 4000
      },
      "remediation": {
        "kind": "list",
        "item": "text"
      },
      "raw_json": {
        "kind": "text",
        "required": true,
        "max_len": 20000
      }
    },
    "render": [
      "statement",
      "severity",
      "rationale",
      "remediation",
      "raw_json"
    ],
    "required_facets": [
      "topic"
    ],
    "review_checklist": [
      "原始记录完整保存在 raw_json",
      "legacy_id 与旧库一致",
      "状态映射正确"
    ],
    "require_sources": false
  }
}