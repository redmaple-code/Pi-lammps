              "type": "string"
            }
          },
          "source_path": {
            "type": "string"
          },
          "project_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finding_id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "to_stage": {
            "type": "string"
          },
