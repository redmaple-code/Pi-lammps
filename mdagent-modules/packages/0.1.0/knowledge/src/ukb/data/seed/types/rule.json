{
  "type_id": "rule",
  "label": "规则",
  "description": "约束、禁则或必须项",
  "spec": {
    "tier": "entry",
    "fields": {
      "statement": {
        "kind": "text",
        "required": true,
        "max_len": 1500
      },
      "severity": {
        "kind": "enum",
        "values": [
          "hard",
          "soft",
          "info"
        ],
        "required": true
      },
      "rationale": {
        "kind": "text",
        "required": true,
        "max_len": 2000
      },
      "check": {
        "kind": "text",
        "required": false,
        "max_len": 1000
      },
      "exceptions": {
        "kind": "text",
        "required": false,
        "max_len": 1000
      }
    },
    "required_facets": [
      "topic"
    ],
    "render": [
      "statement",
      "severity",
      "rationale",
      "check",
      "exceptions"
    ],
    "review_checklist": [
      "一条只讲一件事",
      "标题准确概括内容",
      "适用条件写清，或明确说明普适",
      "来源可回读",
      "已读过同范围条目，无未处理的重复或矛盾",
      "标签按标签说明归类"
    ],
    "require_sources": true
  }
}
