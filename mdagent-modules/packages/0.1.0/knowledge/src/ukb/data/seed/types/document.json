{
  "type_id": "document",
  "label": "文档",
  "description": "手册、标准、报告等长文档：摘要层 + 原文",
  "spec": {
    "tier": "document",
    "fields": {
      "summary": {
        "kind": "text",
        "required": true,
        "max_len": 1500
      },
      "key_points": {
        "kind": "list",
        "item": {
          "kind": "text",
          "max_len": 600
        },
        "required": true
      },
      "scope": {
        "kind": "text",
        "required": false,
        "max_len": 800,
        "description": "适用范围"
      },
      "version_note": {
        "kind": "text",
        "required": false,
        "max_len": 300
      }
    },
    "required_facets": [
      "topic"
    ],
    "render": [
      "summary",
      "key_points",
      "scope",
      "version_note"
    ],
    "review_checklist": [
      "一条只讲一件事",
      "标题准确概括内容",
      "适用条件写清，或明确说明普适",
      "来源可回读",
      "已读过同范围条目，无未处理的重复或矛盾",
      "标签按标签说明归类",
      "摘要与原文一致",
      "要点都有原文定位"
    ],
    "require_sources": false,
    "document": {
      "summary_max_chars": 3000,
      "allowed_roles": [
        "fulltext",
        "excerpt",
        "report",
        "figure",
        "supplement"
      ],
      "required_roles": [
        "fulltext"
      ],
      "summary_must_cite": true,
      "max_files": 30
    }
  }
}
