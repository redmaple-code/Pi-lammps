{
  "schemaVersion": "1.0.0",
  "id": "structural-mechanics",
  "version": "0.1.0-draft",
  "publicationStatus": "draft",
  "scope": {
    "domains": [
      "solid-mechanics"
    ],
    "scales": [
      "continuum"
    ],
    "tasks": [
      "linear-static"
    ],
    "exclusions": [
      "fracture-growth",
      "large-deformation",
      "fluid-structure-coupling"
    ]
  },
  "kernelCompatibility": ">=1.0.0 <2.0.0",
  "dependencies": [],
  "resources": [
    {
      "id": "problem",
      "kind": "problemSchema",
      "path": "problem-schema.yaml",
      "availability": "missing"
    },
    {
      "id": "knowledge",
      "kind": "knowledge",
      "path": "knowledge/catalog.yaml",
      "availability": "missing"
    },
    {
      "id": "models",
      "kind": "model",
      "path": "models/catalog.yaml",
      "availability": "missing"
    },
    {
      "id": "vocabulary",
      "kind": "vocabulary",
      "path": "vocabulary.yaml",
      "availability": "missing"
    },
    {
      "id": "checks",
      "kind": "check",
      "path": "checks/rules.yaml",
      "availability": "missing"
    },
    {
      "id": "metrics",
      "kind": "metric",
      "path": "measurements/metrics.yaml",
      "availability": "missing"
    },
    {
      "id": "failures",
      "kind": "failure",
      "path": "failures/catalog.yaml",
      "availability": "missing"
    },
    {
      "id": "templates",
      "kind": "template",
      "path": "templates/catalog.yaml",
      "availability": "missing"
    },
    {
      "id": "roles",
      "kind": "role",
      "path": "roles.yaml",
      "availability": "missing"
    },
    {
      "id": "validation",
      "kind": "validation",
      "path": "validation/cases.yaml",
      "availability": "missing"
    },
    {
      "id": "artifacts",
      "kind": "artifactSchema",
      "path": "artifacts/schemas/catalog.yaml",
      "availability": "missing"
    }
  ],
  "entrypoints": {
    "problemSchema": "problem",
    "knowledge": [
      "knowledge"
    ],
    "models": [
      "models"
    ],
    "vocabulary": "vocabulary",
    "checks": [
      "checks"
    ],
    "metrics": [
      "metrics"
    ],
    "failures": "failures",
    "templates": [
      "templates"
    ],
    "roles": "roles",
    "validation": [
      "validation"
    ],
    "artifactSchemas": [
      "artifacts"
    ]
  },
  "requiredCapabilities": [
    "geometry.build",
    "mesh.generate",
    "solid.analysis",
    "solid.input.prepare",
    "solid.linear-static.solve"
  ],
  "toolProfiles": [
    {
      "id": "candidate-local",
      "bindings": [
        {
          "capability": "geometry.build",
          "adapterId": "candidate-fem-tools",
          "adapterVersionRange": ">=0.1.0 <1.0.0",
          "toolVersionRange": "*",
          "validationStatus": "unverified"
        },
        {
          "capability": "mesh.generate",
          "adapterId": "candidate-fem-tools",
          "adapterVersionRange": ">=0.1.0 <1.0.0",
          "toolVersionRange": "*",
          "validationStatus": "unverified"
        },
        {
          "capability": "solid.analysis",
          "adapterId": "candidate-fem-tools",
          "adapterVersionRange": ">=0.1.0 <1.0.0",
          "toolVersionRange": "*",
          "validationStatus": "unverified"
        },
        {
          "capability": "solid.input.prepare",
          "adapterId": "candidate-fem-tools",
          "adapterVersionRange": ">=0.1.0 <1.0.0",
          "toolVersionRange": "*",
          "validationStatus": "unverified"
        },
        {
          "capability": "solid.linear-static.solve",
          "adapterId": "candidate-fem-tools",
          "adapterVersionRange": ">=0.1.0 <1.0.0",
          "toolVersionRange": "*",
          "validationStatus": "unverified"
        }
      ]
    }
  ],
  "defaultToolProfile": "candidate-local",
  "workflows": [
    {
      "id": "linear-static",
      "taskType": "linear-static",
      "inputs": [
        "approved-problem"
      ],
      "outputs": [
        "metrics"
      ],
      "stages": [
        {
          "id": "geometry",
          "kind": "action",
          "role": "model-builder",
          "needs": [],
          "consumes": [
            "approved-problem"
          ],
          "produces": [
            "geometry"
          ],
          "checkRefs": [
            "checks#geometry-features"
          ],
          "reviewRequired": true,
          "capability": "geometry.build"
        },
        {
          "id": "mesh",
          "kind": "action",
          "role": "model-builder",
          "needs": [
            "geometry"
          ],
          "consumes": [
            "geometry"
          ],
          "produces": [
            "mesh"
          ],
          "checkRefs": [
            "checks#mesh-quality"
          ],
          "reviewRequired": false,
          "capability": "mesh.generate"
        },
        {
          "id": "configure",
          "kind": "action",
          "role": "model-builder",
          "needs": [
            "mesh"
          ],
          "consumes": [
            "approved-problem",
            "geometry",
            "mesh"
          ],
          "produces": [
            "solver-input"
          ],
          "checkRefs": [
            "checks#constraints-valid"
          ],
          "reviewRequired": true,
          "capability": "solid.input.prepare"
        },
        {
          "id": "solve",
          "kind": "action",
          "role": "executor",
          "needs": [
            "configure"
          ],
          "consumes": [
            "solver-input"
          ],
          "produces": [
            "solution"
          ],
          "checkRefs": [
            "checks#execution-complete"
          ],
          "reviewRequired": false,
          "capability": "solid.linear-static.solve"
        },
        {
          "id": "analyze",
          "kind": "action",
          "role": "analyst",
          "needs": [
            "solve"
          ],
          "consumes": [
            "approved-problem",
            "solution"
          ],
          "produces": [
            "metrics"
          ],
          "checkRefs": [
            "checks#equilibrium-valid"
          ],
          "reviewRequired": false,
          "capability": "solid.analysis"
        }
      ]
    }
  ],
  "defaultWorkflow": "linear-static",
  "policies": {
    "referencePolicy": "verifiedBasis",
    "independentReviewRequired": true,
    "maxConsecutiveRevisions": 3,
    "maxConsecutiveRepairFailures": 3
  },
  "extensions": {
    "spec.example": {
      "purpose": "开发规范示例，不含真实科学资产，不可发布或生产运行。",
      "toolBindingNote": "adapterId 和版本范围为候选占位；实际工具版本须验证后锁定。",
      "policyNote": "次数仅为配置示例，非通用科学阈值。"
    }
  }
}
