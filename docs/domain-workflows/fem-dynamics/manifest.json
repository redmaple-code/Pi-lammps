          ],
          "checkRefs": [
            "checks#scope-inputs"
          ],
          "reviewRequired": true,
          "capability": "fem.dynamics.plan"
        },
        {
          "id": "geometry",
          "kind": "action",
          "role": "model-builder",
          "needs": [
            "plan"
