          "consumes": [
            "task",
            "plan",
            "geometry-bundle"
          ],
          "produces": [
            "discrete-model"
          ],
          "checkRefs": [
            "checks#mesh-material-mass"
          ],
          "reviewRequired": false,
          "capability": "fem.mesh.prepare"
        },
        {
          "id": "configure",
          "kind": "action",
          "role": "model-builder",
          "needs": [
            "discretize"
          ],
          "consumes": [
            "task",
            "plan",
            "discrete-model"
          ],
          "produces": [
            "dynamic-input"
          ],
          "checkRefs": [
            "checks#input-protocol"
          ],
          "reviewRequired": true,
          "capability": "fem.dynamics.input"
        },
        {
          "id": "qualify",
          "kind": "action",
          "role": "validator",
          "needs": [
            "configure"
          ],
          "consumes": [
            "task",
            "plan",
            "dynamic-input"
          ],
          "produces": [
            "qualification"
          ],
          "checkRefs": [
            "checks#procedure-compatible"
          ],
          "reviewRequired": true,
          "capability": "fem.dynamics.qualify"
        },
        {
          "id": "solve",
          "kind": "action",
          "role": "executor",
          "needs": [
            "qualify"
          ],
          "consumes": [
            "task",
            "dynamic-input",
            "qualification"
          ],
          "produces": [
            "solution"
          ],
          "checkRefs": [
            "checks#execution-complete",
            "checks#modal-basis"
          ],
          "reviewRequired": false,
          "capability": "fem.modal.solve"
        },
        {
          "id": "verify",
          "kind": "iteration",
          "role": "validator",
          "needs": [
            "solve"
          ],
          "consumes": [
            "task",
            "plan",
            "dynamic-input",
            "qualification",
            "solution"
          ],
          "produces": [
            "verification"
          ],
          "checkRefs": [
            "checks#numerical-verification"
          ],
          "reviewRequired": true,
          "bodyWorkflowRef": "verification-sample",
          "iterationProtocolRef": "protocols#discretization-study",
          "maxIterations": 6,
          "untilCheckRef": "checks#numerical-verification"
        },
        {
          "id": "analyze",
          "kind": "action",
          "role": "analyst",
          "needs": [
            "verify"
          ],
          "consumes": [
            "task",
            "solution",
            "verification"
          ],
          "produces": [
            "metrics"
          ],
          "checkRefs": [
            "checks#metric-definition"
          ],
          "reviewRequired": true,
          "capability": "fem.dynamics.analyze"
        },
        {
          "id": "report",
          "kind": "action",
          "role": "post-processor",
          "needs": [
            "analyze"
          ],
          "consumes": [
            "task",
            "solution",
            "verification",
            "metrics"
          ],
          "produces": [
            "deliverables"
          ],
          "checkRefs": [
            "checks#report-traceable"
          ],
          "reviewRequired": false,
          "capability": "fem.dynamics.report"
        }
      ]
    },
