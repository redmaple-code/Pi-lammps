{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-domain simulation domain pack v1",
  "description": "Normative structure only. Resource, scientific, graph, policy and release-receipt validation are additional requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "publicationStatus",
    "scope",
    "kernelCompatibility",
    "dependencies",
    "resources",
    "entrypoints",
    "requiredCapabilities",
    "toolProfiles",
    "defaultToolProfile",
    "workflows",
    "defaultWorkflow",
    "policies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "publicationStatus": {
      "enum": [
        "draft",
        "released"
      ]
    },
    "releaseReceiptRef": {
      "$ref": "#/$defs/resourceRef"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "scales",
        "tasks",
        "exclusions"
      ],
      "properties": {
        "domains": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "scales": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "tasks": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "exclusions": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "kernelCompatibility": {
      "$ref": "#/$defs/text"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "versionRange"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "versionRange": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problemSchema",
        "knowledge",
        "models",
        "vocabulary",
        "checks",
        "metrics",
        "failures",
        "templates",
        "roles",
        "validation",
        "artifactSchemas"
      ],
      "properties": {
        "problemSchema": {
          "$ref": "#/$defs/resourceRef"
        },
        "knowledge": {
          "$ref": "#/$defs/resourceRefs"
        },
        "models": {
          "$ref": "#/$defs/resourceRefs"
        },
        "vocabulary": {
          "$ref": "#/$defs/resourceRef"
        },
        "checks": {
          "$ref": "#/$defs/resourceRefs"
        },
        "metrics": {
          "$ref": "#/$defs/resourceRefs"
        },
        "failures": {
          "$ref": "#/$defs/resourceRef"
        },
        "templates": {
          "$ref": "#/$defs/resourceRefs"
        },
        "roles": {
          "$ref": "#/$defs/resourceRef"
        },
        "validation": {
          "$ref": "#/$defs/resourceRefs"
        },
        "artifactSchemas": {
          "$ref": "#/$defs/resourceRefs"
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "toolProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/toolProfile"
      }
    },
    "defaultToolProfile": {
      "$ref": "#/$defs/id"
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflow"
      }
    },
    "defaultWorkflow": {
      "$ref": "#/$defs/id"
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referencePolicy",
        "independentReviewRequired",
        "maxConsecutiveRevisions",
        "maxConsecutiveRepairFailures"
      ],
      "properties": {
        "referencePolicy": {
          "enum": [
            "verifiedBasis",
            "localCaseRequired"
          ]
        },
        "independentReviewRequired": {
          "const": true
        },
        "maxConsecutiveRevisions": {
          "type": "integer",
          "minimum": 1
        },
        "maxConsecutiveRepairFailures": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publicationStatus": {
            "const": "released"
          }
        }
      },
      "then": {
        "required": [
          "releaseReceiptRef"
        ],
        "properties": {
          "resources": {
            "items": {
              "properties": {
                "availability": {
                  "const": "available"
                }
              }
            }
          },
          "toolProfiles": {
            "items": {
              "properties": {
                "bindings": {
                  "items": {
                    "properties": {
                      "validationStatus": {
                        "const": "validated"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "resourceRef": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9-]*::)?[a-z][a-z0-9-]*(?:#[a-z][a-z0-9-]*)?$"
    },
    "resourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceRef"
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "availability"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "problemSchema",
            "knowledge",
            "model",
            "vocabulary",
            "check",
            "metric",
            "failure",
            "template",
            "role",
            "validation",
            "artifactSchema",
            "protocol"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:]).+$"
        },
        "availability": {
          "enum": [
            "available",
            "missing"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ]
    },
    "toolProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bindings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "adapterId",
              "adapterVersionRange",
              "toolVersionRange",
              "validationStatus"
            ],
            "properties": {
              "capability": {
                "$ref": "#/$defs/capability"
              },
              "adapterId": {
                "$ref": "#/$defs/id"
              },
              "adapterVersionRange": {
                "$ref": "#/$defs/text"
              },
              "toolVersionRange": {
                "$ref": "#/$defs/text"
              },
              "validationStatus": {
                "enum": [
                  "unverified",
                  "validated"
                ]
              },
              "validationReceiptRef": {
                "$ref": "#/$defs/resourceRef"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "validationStatus": {
                      "const": "validated"
                    }
                  }
                },
                "then": {
                  "required": [
                    "validationReceiptRef"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "taskType",
        "inputs",
        "outputs",
        "stages"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "taskType": {
          "$ref": "#/$defs/id"
        },
        "inputs": {
          "$ref": "#/$defs/strings"
        },
        "outputs": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "needs",
        "consumes",
        "produces",
        "checkRefs",
        "reviewRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "action",
            "iteration"
          ]
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "consumes": {
          "$ref": "#/$defs/strings"
        },
        "produces": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "checkRefs": {
          "$ref": "#/$defs/resourceRefs"
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "bodyWorkflowRef": {
          "$ref": "#/$defs/id"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "untilCheckRef": {
          "$ref": "#/$defs/resourceRef"
        },
        "iterationProtocolRef": {
          "$ref": "#/$defs/resourceRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "action"
              }
            }
          },
          "then": {
            "required": [
              "capability"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "bodyWorkflowRef"
                  ]
                },
                {
                  "required": [
                    "maxIterations"
                  ]
                },
                {
                  "required": [
                    "untilCheckRef"
                  ]
                },
                {
                  "required": [
                    "iterationProtocolRef"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "iteration"
              }
            }
          },
          "then": {
            "required": [
              "bodyWorkflowRef",
              "maxIterations",
              "untilCheckRef",
              "iterationProtocolRef"
            ],
            "not": {
              "required": [
                "capability"
              ]
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fact",
            "op",
            "value"
          ],
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:\\.[a-zA-Z][a-zA-Z0-9]*)*$"
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "in",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "array"
              ],
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      ]
    }
  }
}
